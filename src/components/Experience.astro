---
/* Experiencia, formación y certificaciones; en «Sobre mí» también las herramientas por grupo. */
import SectionHead from './SectionHead.astro';
import { certs, education, jobs, skills, spoken } from '../data/career';
import { type Lang, useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  full?: boolean;
}
const { lang, full = false } = Astro.props;
const t = useT(lang);
const es = lang === 'es';
---

<section id="experiencia" class="wrap scroll-mt-6 py-16 md:py-24" aria-labelledby="exp-title">
  <SectionHead id="exp-title" kicker={t('exp.kicker')} title={t('exp.title')} />

  <ol class="mt-10 grid gap-4" data-reveal="stagger">
    {
      jobs.map((job) => (
        <li class="card grid gap-x-8 gap-y-4 p-6 md:grid-cols-12">
          <div class="md:col-span-4">
            <h3 class="h-card">{job.role[lang]}</h3>
            <p class="mt-1 text-ink-2">
              {job.org} <span class="text-ink-3">· {job.place[lang]}</span>
            </p>
            <p class="label mt-3 text-violet-ink">{job.date[lang]}</p>
          </div>
          <ul class="grid gap-2.5 text-[0.95rem]/relaxed text-ink-2 md:col-span-8">
            {job.points[lang].map((pt) => (
              <li class="relative pl-5 before:absolute before:top-[0.75em] before:left-0 before:h-px before:w-2.5 before:bg-violet-ink">{pt}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  <div class="mt-12 grid gap-8 lg:grid-cols-2">
    <div data-reveal="up">
      <h3 class="label text-violet-ink">{t('edu.title')}</h3>
      <ul class="mt-4 grid gap-4">
        {
          education.map((s) => (
            <li class="card p-5">
              <p class="flex items-center gap-3 text-[1.05rem] font-semibold">
                {s.current && <span class="dot-live" aria-hidden="true" />}
                {s.title[lang]}
              </p>
              <p class="mt-1 text-[0.95rem] text-ink-2">{s.org}</p>
              <p class="label mt-2 text-ink-3">{s.date[lang]}</p>
            </li>
          ))
        }
        <li class="card p-5">
          <p class="label text-ink-3">{es ? 'Idiomas' : 'Languages'}</p>
          <p class="mt-1.5 text-[0.95rem] text-ink-2">{spoken[lang]}</p>
        </li>
      </ul>
    </div>

    <div data-reveal="up">
      <h3 class="label text-violet-ink">{t('certs.title')}</h3>
      <ul class="card mt-4 divide-y divide-line px-5">
        {
          certs.map((c) => (
            <li class="flex items-baseline justify-between gap-4 py-3">
              <span class:list={['flex items-baseline gap-2.5 text-[0.95rem]', c.highlight ? 'text-ink' : 'text-ink-2']}>
                <span class:list={['label', c.highlight ? 'text-violet-ink' : 'text-ink-3']} aria-hidden="true">
                  {c.highlight ? '★' : '·'}
                </span>
                <span>
                  {c.title[lang]} <span class="text-ink-3">— {c.issuer}</span>
                </span>
              </span>
              {c.date && <span class="label shrink-0 text-ink-3">{c.date[lang]}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {
    full && (
      <div class="mt-12" data-reveal="up">
        <h3 class="label text-violet-ink">{t('skills.title')}</h3>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {skills.map((g) => (
            <div class="card p-5">
              <dt class="text-[0.95rem] font-semibold">{g.name[lang]}</dt>
              <dd class="mt-3 flex flex-wrap gap-1.5">
                {g.items.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
</section>
