---
/* Menú para descargar la hoja de vida: 2 perfiles × 2 idiomas. */
import { cvs } from '../data/profile';
import { type Lang, url, useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  variant?: 'primary' | 'ghost' | 'compact';
  align?: 'left' | 'right';
  up?: boolean;
  class?: string;
}
const { lang, variant = 'primary', align = 'left', up = false, class: className = '' } = Astro.props;
const t = useT(lang);
// Primero las versiones en el idioma de la página.
const ordered = [...cvs].sort((a, b) => Number(b.lang === lang.toUpperCase()) - Number(a.lang === lang.toUpperCase()));
---

<details class:list={['cv-menu relative', `cv-${variant}`, className]} data-cv-menu>
  <summary
    class:list={[
      'btn w-full cursor-pointer list-none select-none',
      variant === 'primary' && 'btn-primary',
      variant === 'compact' && 'h-9! px-3! text-xs!',
    ]}
  >
    <span>{variant === 'compact' ? t('cv.short') : t('cv.button')}</span>
    <svg class="arrow arrow-down h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M8 2.5v10M3.5 8.5 8 13l4.5-4.5M2.5 14.5h11"></path>
    </svg>
  </summary>
  <div
    class:list={[
      'cv-panel absolute z-50 w-[min(22rem,calc(100vw-2.5rem))] overflow-hidden rounded-xl border border-line-strong bg-bg-2 shadow-[0_30px_60px_-20px_rgb(0_0_0/0.7)]',
      align === 'right' ? 'right-0' : 'left-0',
      up ? 'bottom-full mb-2' : 'top-full mt-2',
    ]}
  >
    <p class="label flex items-center justify-between border-b border-line py-2 pr-2 pl-4 text-ink-3">
      <span>{t('cv.title')}</span>
      <button type="button" class="grid h-8 w-8 place-items-center rounded-md text-ink-2 hover:bg-bg-3 hover:text-ink" aria-label={t('nav.close')} data-cv-close>
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 3l10 10M13 3 3 13" /></svg>
      </button>
    </p>
    <ul>
      {
        ordered.map((cv) => (
          <li class="border-b border-line last:border-0">
            <a
              href={url(cv.file)}
              download
              class="group flex items-center justify-between gap-4 px-4 py-3.5 transition-colors hover:bg-bg-3"
            >
              <span class="text-[0.95rem] font-medium text-ink">{cv.role[lang]}</span>
              <span class="label flex items-center gap-2 text-ink-3 group-hover:text-violet-ink">
                {cv.lang} · PDF
                <svg class="h-3 w-3 transition-transform group-hover:translate-y-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M8 2v10M3.5 7.5 8 12l4.5-4.5" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="label px-4 py-2.5 text-[0.6875rem] text-ink-3 normal-case">{t('cv.note')}</p>
  </div>
</details>

<style>
  .cv-menu > summary::-webkit-details-marker {
    display: none;
  }
  .cv-menu[open] > summary {
    border-color: var(--c-ink);
  }
  .cv-menu.cv-primary[open] > summary {
    background: var(--c-violet-hover);
    border-color: var(--c-violet-hover);
  }
  .cv-menu[open] .cv-panel {
    animation: cv-in 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @keyframes cv-in {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
  }

  /* En móvil el menú es una hoja pegada abajo con fondo oscuro: nunca se recorta ni se sale de la pantalla. */
  @media (max-width: 39.99rem) {
    .cv-menu[open]::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 65;
      background: rgb(0 0 0 / 0.55);
      animation: cv-fade 0.25s;
    }
    .cv-panel {
      position: fixed;
      inset: auto 0.75rem max(0.75rem, env(safe-area-inset-bottom)) 0.75rem;
      z-index: 70;
      width: auto;
      margin: 0;
    }
    .cv-menu[open] .cv-panel {
      animation: cv-up 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }
  @keyframes cv-up {
    from {
      opacity: 0;
      translate: 0 16px;
    }
  }
  @keyframes cv-fade {
    from {
      opacity: 0;
    }
  }
</style>
