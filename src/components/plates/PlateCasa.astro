---
/* Casa Alberto: plano de un marco como lo arma el cotizador (moldura, paspartú, vidrio) con las reglas de
   negocio del repositorio (docs/BUSINESS_RULES.md). Dentro del marco, los cerros de Bogotá con Monserrate. */
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';

// Marco: exterior, borde interior de la moldura y ventana del paspartú.
const O = { x: 96, y: 78, w: 288, h: 368 };
const M = 22; // moldura
const P = 34; // paspartú
const I = { x: O.x + M, y: O.y + M, w: O.w - M * 2, h: O.h - M * 2 };
const W = { x: I.x + P, y: I.y + P, w: I.w - P * 2, h: I.h - P * 2 };

const legend = [
  { n: '01', k: es ? 'MOLDURA' : 'MOULDING', v: es ? 'perfil y ancho por metro' : 'profile and width per meter' },
  { n: '02', k: es ? 'PASPARTÚ' : 'MAT', v: es ? 'ancho máximo razonable · BR-007' : 'reasonable max width · BR-007' },
  { n: '03', k: es ? 'VIDRIO' : 'GLASS', v: es ? 'múltiplo de 10 cm · BR-003' : 'multiple of 10 cm · BR-003' },
  { n: '04', k: es ? 'MEDIDAS' : 'SIZE', v: es ? 'válidas de 1 a 500 cm · BR-002' : 'valid from 1 to 500 cm · BR-002' },
];

// Cerros orientales con Monserrate.
const ridge = [
  [W.x, W.y + 196],
  [W.x + 22, W.y + 178],
  [W.x + 40, W.y + 186],
  [W.x + 66, W.y + 150],
  [W.x + 82, W.y + 138],
  [W.x + 92, W.y + 142],
  [W.x + 112, W.y + 168],
  [W.x + 134, W.y + 158],
  [W.x + 160, W.y + 182],
  [W.x + W.w, W.y + 176],
]
  .map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`)
  .join(' ');
---

<svg class="plate" viewBox="0 0 800 500" aria-hidden="true" data-draw>
  <defs>
    <pattern id="grid-casa" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" class="s-faint" stroke-width="0.5"></path>
    </pattern>
    <pattern id="hatch-casa" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="8" stroke="var(--c-ink-3)" stroke-width="0.6"></line>
    </pattern>
  </defs>
  <rect width="800" height="500" fill="url(#grid-casa)" opacity="0.5"></rect>

  <!-- Moldura con cortes a inglete -->
  <path
    d={`M${O.x} ${O.y}h${O.w}v${O.h}h-${O.w}Z M${I.x} ${I.y}h${I.w}v${I.h}h-${I.w}Z`}
    fill="url(#hatch-casa)"
    fill-rule="evenodd"
    class="fade"
    opacity="0.7"></path>
  <rect x={O.x} y={O.y} width={O.w} height={O.h} class="s-ink draw"></rect>
  <rect x={I.x} y={I.y} width={I.w} height={I.h} class="s-ink draw"></rect>
  <line x1={O.x} y1={O.y} x2={I.x} y2={I.y} class="s-ink draw"></line>
  <line x1={O.x + O.w} y1={O.y} x2={I.x + I.w} y2={I.y} class="s-ink draw"></line>
  <line x1={O.x + O.w} y1={O.y + O.h} x2={I.x + I.w} y2={I.y + I.h} class="s-ink draw"></line>
  <line x1={O.x} y1={O.y + O.h} x2={I.x} y2={I.y + I.h} class="s-ink draw"></line>

  <!-- Paspartú con bisel -->
  <rect x={W.x} y={W.y} width={W.w} height={W.h} class="s-line draw"></rect>
  <rect x={W.x - 4} y={W.y - 4} width={W.w + 8} height={W.h + 8} class="s-faint draw"></rect>

  <!-- La obra: cerros orientales, Monserrate y el sol -->
  <path d={ridge} class="s-acc draw" stroke-width="1.6" stroke-linejoin="round"></path>
  <path d={`M${W.x + 79} ${W.y + 139}v-9m-4 3h8`} class="s-acc draw" stroke-width="1.4"></path>
  <circle cx={W.x + W.w - 40} cy={W.y + 62} r="14" class="s-acc draw"></circle>
  <path d={`M${W.x + 12} ${W.y + W.h - 34}h${W.w - 24}M${W.x + 12} ${W.y + W.h - 22}h${W.w - 60}`} class="s-faint draw"></path>

  <!-- Vidrio: reflejos -->
  <path d={`M${W.x + 18} ${W.y + 44}l26-26M${W.x + 18} ${W.y + 62}l40-40`} class="s-line fade"></path>

  <!-- Cotas -->
  <g class="fade">
    <line x1={O.x} y1="50" x2={O.x + O.w} y2="50" class="s-line"></line>
    <line x1={O.x} y1="44" x2={O.x} y2="70" class="s-line"></line>
    <line x1={O.x + O.w} y1="44" x2={O.x + O.w} y2="70" class="s-line"></line>
    <rect x={O.x + O.w / 2 - 28} y="42" width="56" height="16" fill="var(--c-plate)"></rect>
    <text x={O.x + O.w / 2} y="54" text-anchor="middle" class="t-hi" font-size="10.5">50 cm</text>

    <line x1="412" y1={O.y} x2="412" y2={O.y + O.h} class="s-line"></line>
    <line x1="392" y1={O.y} x2="418" y2={O.y} class="s-line"></line>
    <line x1="392" y1={O.y + O.h} x2="418" y2={O.y + O.h} class="s-line"></line>
    <rect x="404" y={O.y + O.h / 2 - 28} width="16" height="56" fill="var(--c-plate)"></rect>
    <text x={-(O.y + O.h / 2)} y="416" transform="rotate(-90)" text-anchor="middle" class="t-hi" font-size="10.5">70 cm</text>
  </g>

  <!-- Llamadas -->
  {
    [
      [O.x + M / 2, O.y + O.h / 2 + 40],
      [I.x + P / 2, I.y + I.h / 2 + 70],
      [W.x + 36, W.y + 32],
      [O.x + O.w / 2 + 70, 50],
    ].map(([x, y], i) => (
      <g class="pop">
        <circle cx={x} cy={y} r="9" fill="var(--c-violet)" />
        <text x={x} y={y + 3.5} text-anchor="middle" font-size="9" class="t-white">
          {i + 1}
        </text>
      </g>
    ))
  }

  <!-- Leyenda -->
  <line x1="456" y1="40" x2="456" y2="470" class="s-faint draw"></line>
  <text x="484" y="52" class="t-dim">{es ? 'COTIZADOR · PIEZAS DEL MARCO' : 'QUOTING TOOL · FRAME PARTS'}</text>
  {
    legend.map((l, i) => {
      const y = 96 + i * 52;
      return (
        <g class="fade">
          <text x="484" y={y} class="t-acc" font-size="10.5">
            {l.n}
          </text>
          <text x="514" y={y} class="t-hi" font-size="11">
            {l.k}
          </text>
          <text x="514" y={y + 18} class="t-dim" font-size="10">
            {l.v}
          </text>
          <line x1="484" y1={y + 32} x2="768" y2={y + 32} class="s-faint" />
        </g>
      );
    })
  }

  <!-- Rótulo -->
  <rect x="484" y="330" width="284" height="116" class="s-line draw"></rect>
  <line x1="484" y1="368" x2="768" y2="368" class="s-line draw"></line>
  <line x1="484" y1="407" x2="768" y2="407" class="s-line draw"></line>
  <line x1="626" y1="368" x2="626" y2="446" class="s-line draw"></line>
  <g class="fade">
    <text x="496" y="354" class="t-hi" font-size="12">CASA ALBERTO · {es ? 'MARQUETERÍA' : 'FRAME SHOP'}</text>
    <text x="496" y="384" class="t-dim" font-size="9">{es ? 'BARRIO' : 'NEIGHBORHOOD'}</text>
    <text x="496" y="399" class="t-hi" font-size="10.5">Verbenal, Bogotá</text>
    <text x="638" y="384" class="t-dim" font-size="9">{es ? 'OFICIO' : 'CRAFT'}</text>
    <text x="638" y="399" class="t-hi" font-size="10.5">{es ? '36 años' : '36 years'}</text>
    <text x="496" y="423" class="t-dim" font-size="9">{es ? 'ESCALA' : 'SCALE'}</text>
    <text x="496" y="438" class="t-hi" font-size="10.5">1:10</text>
    <text x="638" y="423" class="t-dim" font-size="9">{es ? 'APP' : 'APP'}</text>
    <text x="638" y="438" class="t-acc" font-size="10.5">v2.3.2</text>
  </g>
</svg>
