---
/* Trading Lab: flujo event-driven market → signal → proposal → risk → execution (README de ~/Desktop/crypto). */
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';

const Y = 196;
const H = 64;
const W = 124;
const boxes = [
  { x: 28, title: 'COINBASE', sub: 'WebSocket feed' },
  { x: 182, title: 'DATA', sub: es ? 'velas OHLCV' : 'OHLCV bars' },
  { x: 336, title: 'SIGNALS', sub: es ? 'señales tipadas' : 'typed signals' },
  { x: 490, title: 'RISK', sub: es ? '7 validaciones' : '7 pre-trade checks', hi: true },
  { x: 644, title: 'EXECUTION', sub: 'adapter' },
];
const guards = es
  ? ['kill switch (.kill)', 'circuit breaker diario', 'límites que rechazan']
  : ['kill switch (.kill)', 'daily circuit breaker', 'hard-reject limits'];
---

<svg class="plate" viewBox="0 0 800 500" aria-hidden="true" data-draw>
  <defs>
    <pattern id="grid-trading" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" class="s-faint" stroke-width="0.5"></path>
    </pattern>
    <marker id="arrow-trading" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0 1 9 5 0 9" fill="none" stroke="var(--c-ink-2)" stroke-width="1.4"></path>
    </marker>
  </defs>
  <rect width="800" height="500" fill="url(#grid-trading)" opacity="0.5"></rect>

  <text x="28" y="52" class="t-dim">{es ? 'ARQUITECTURA · 8 MÓDULOS · ORIENTADA A EVENTOS' : 'ARCHITECTURE · 8 MODULES · EVENT-DRIVEN'}</text>
  <text x="772" y="52" text-anchor="end" class="t-acc">TypeScript strict</text>

  <!-- Sentimiento -->
  <rect x="318" y="84" width="160" height="56" class="s-line draw"></rect>
  <text x="398" y="108" text-anchor="middle" class="t-hi fade">SENTIMENT</text>
  <text x="398" y="126" text-anchor="middle" class="t-dim fade" font-size="10">FastAPI · FinBERT · Docker</text>
  <line x1="398" y1="140" x2="398" y2={Y - 4} class="s-ink draw" marker-end="url(#arrow-trading)"></line>

  <!-- Flujo principal -->
  {
    boxes.map((b, i) => (
      <g>
        {b.hi && <rect x={b.x} y={Y} width={W} height={H} class="f-violet fade" opacity="0.18" />}
        <rect x={b.x} y={Y} width={W} height={H} class={b.hi ? 's-acc draw' : 's-line draw'} />
        <text x={b.x + 12} y={Y + 26} class={b.hi ? 't-acc fade' : 't-hi fade'}>
          {b.title}
        </text>
        <text x={b.x + 12} y={Y + 46} class="t-dim fade" font-size="10">
          {b.sub}
        </text>
        <text x={b.x + W - 10} y={Y + 26} text-anchor="end" class="t-dim fade" font-size="9.5">
          0{i + 1}
        </text>
        {i < boxes.length - 1 && (
          <line x1={b.x + W} y1={Y + H / 2} x2={boxes[i + 1].x - 3} y2={Y + H / 2} class="s-ink draw" marker-end="url(#arrow-trading)" />
        )}
      </g>
    ))
  }

  <!-- Journal -->
  <line x1="244" y1={Y + H} x2="244" y2="326" class="s-ink draw" marker-end="url(#arrow-trading)"></line>
  <rect x="164" y="330" width="160" height="56" class="s-line draw"></rect>
  <text x="176" y="354" class="t-hi fade">JOURNAL</text>
  <text x="176" y="372" class="t-dim fade" font-size="10">SQLite · append-only</text>

  <!-- Guardas de riesgo -->
  <path d={`M552 ${Y + H}V300H552`} class="s-acc draw" stroke-dasharray="3 4"></path>
  {
    guards.map((g, i) => (
      <g class="fade">
        <rect x="498" y={304 + i * 26} width="6" height="6" class="f-acc" />
        <text x="512" y={311 + i * 26} class="t-dim" font-size="10.5">
          {g}
        </text>
      </g>
    ))
  }

  <!-- Ejecución -->
  <line x1="680" y1={Y + H} x2="680" y2="300" class="s-ink draw"></line>
  <line x1="740" y1={Y + H} x2="740" y2="300" class="s-ink draw"></line>
  <rect x="650" y="300" width="60" height="30" class="s-line draw"></rect>
  <text x="680" y="319" text-anchor="middle" class="t-hi fade" font-size="10">PAPER</text>
  <rect x="714" y="300" width="60" height="30" class="s-line draw"></rect>
  <text x="744" y="319" text-anchor="middle" class="t-hi fade" font-size="10">DEVNET</text>
  <text x="712" y="360" text-anchor="middle" class="t-dim fade" font-size="10">MAINNET</text>
  <line x1="684" y1="356" x2="740" y2="356" class="s-acc draw" stroke-width="1.4"></line>
  <text x="712" y="378" text-anchor="middle" class="t-dim fade" font-size="9.5">{es ? 'no implementado' : 'not implemented'}</text>

  <!-- Bus de eventos -->
  <line x1="28" y1="438" x2="772" y2="438" class="s-acc draw"></line>
  {boxes.map((b) => <circle cx={b.x + W / 2} cy="438" r="3.5" class="f-acc pop" />)}
  <text x="28" y="464" class="t-dim fade" font-size="10">EVENT BUS</text>
  <text x="772" y="464" text-anchor="end" class="t-dim fade" font-size="10">market → signal → proposal → risk → execution</text>
</svg>
