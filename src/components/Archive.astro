---
/* Archivo: emprendimientos y proyectos anteriores, en tarjetas pequeñas. */
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { archive } from '../data/projects';
import { type Lang, useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="wrap py-16 md:py-24" aria-labelledby="archivo-title">
  <SectionHead id="archivo-title" kicker={t('more.kicker')} title={t('more.title')} intro={t('more.intro')} />

  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger" data-stagger="0.08">
    {
      archive.map((item) => (
        <li class="card card-hover flex flex-col overflow-hidden">
          <div class="relative aspect-[16/10] border-b border-line bg-plate">
            {item.image ? (
              <Image
                src={item.image.src}
                alt={item.image.alt[lang]}
                widths={[400, 640]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                class:list={['h-full w-full', item.title === 'Astrobear' ? 'object-contain' : 'object-cover']}
              />
            ) : (
              <div class="flex h-full items-center justify-center font-mono text-sm text-ink-3">{item.stack.slice(0, 2).join(' · ')}</div>
            )}
          </div>
          <div class="flex flex-1 flex-col p-4">
            <p class="label text-ink-3">
              {item.year !== '—' && <span>{item.year} · </span>}
              {item.kind[lang]}
            </p>
            <h3 class="h-card mt-1.5 text-[1.05rem]">{item.title}</h3>
            <p class="mt-1.5 text-[0.9rem]/relaxed text-ink-2">{item.text[lang]}</p>
            {(item.links.live || item.links.code) && (
              <div class="label mt-auto flex gap-5 pt-4 text-ink-2">
                {item.links.live && (
                  <a href={item.links.live} target="_blank" rel="noopener" class="link-u hover:text-ink">
                    {t('work.visit')} ↗
                  </a>
                )}
                {item.links.code && (
                  <a href={item.links.code} target="_blank" rel="noopener" class="link-u hover:text-ink">
                    {t('work.code')} ↗
                  </a>
                )}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>
