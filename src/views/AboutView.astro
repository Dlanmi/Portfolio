---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import Experience from '../components/Experience.astro';
import CvMenu from '../components/CvMenu.astro';
import { about } from '../data/about';
import { type Lang, routes, url, useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const [first, ...rest] = about.story[lang];
const description =
  lang === 'es'
    ? 'Quién es Daniel Ojeda, Software Engineer y Data Analyst en Bogotá: historia, estudios en Ingeniería de Software, experiencia en PBS Group, certificaciones y herramientas.'
    : 'Who Daniel Ojeda is, Software Engineer and Data Analyst in Bogotá: story, Software Engineering studies, experience at PBS Group, certifications and toolbox.';
const site = Astro.site ?? new URL('http://localhost:4321');
const abs = (path: string) => new URL(url(path), site).href;
const schema = [
  { '@type': 'ProfilePage', name: about.headline[lang], url: abs(routes.about(lang)), inLanguage: lang, mainEntity: { '@id': `${abs(routes.home('es'))}#daniel` } },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: lang === 'es' ? 'Inicio' : 'Home', item: abs(routes.home(lang)) },
      { '@type': 'ListItem', position: 2, name: t('nav.about'), item: abs(routes.about(lang)) },
    ],
  },
];
const pageTitle = lang === 'es' ? 'Sobre mí: historia, estudios y experiencia' : 'About me: story, studies and experience';
---

<Base lang={lang} alternate={routes.about(other)} title={pageTitle} description={description} schema={schema}>
  <section class="wrap pt-[calc(var(--header-h)+3rem)] md:pt-[calc(var(--header-h)+4.5rem)]">
    <a href={url(routes.home(lang))} class="label link-u text-ink-3 hover:text-ink" data-hero-fade>← {lang === 'es' ? 'Inicio' : 'Home'}</a>
    <div class="mt-8 grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7" data-hero-fade>
        <p class="label text-violet-ink">{t('about.kicker')}</p>
        <h1 class="mt-3 font-mono text-[clamp(1.9rem,4vw,3rem)] leading-[1.15] font-bold tracking-tight">{about.headline[lang]}</h1>
        <p class="mt-6 text-[1.125rem]/relaxed text-ink">{first}</p>
        <div class="mt-5 grid gap-4 text-[1.0625rem]/relaxed text-ink-2">
          {rest.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="lg:col-span-5" data-hero-fade>
        <Portrait />
      </div>
    </div>

    <div class="card mt-14 flex flex-col gap-6 p-6 md:flex-row md:items-center md:justify-between" data-reveal="up">
      <p class="max-w-[40rem] text-[1.05rem]/relaxed text-ink">{about.looking[lang]}</p>
      <div class="flex shrink-0 flex-wrap gap-3">
        <CvMenu lang={lang} variant="primary" />
        <a href="#contacto" class="btn">{t('nav.contact')} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="wrap mt-20 md:mt-28" aria-labelledby="como-title">
    <p class="label text-violet-ink" data-reveal="up">{lang === 'es' ? 'Cómo trabajo' : 'How I work'}</p>
    <h2 id="como-title" class="h-section mt-3" data-reveal="up">{lang === 'es' ? 'Tres cosas en las que insisto' : 'Three things I insist on'}</h2>
    <ol class="mt-10 grid gap-4 md:grid-cols-3" data-reveal="stagger">
      {
        about.principles.map((pr, i) => (
          <li class="card p-6">
            <span class="font-mono text-3xl font-bold text-violet-ink">0{i + 1}</span>
            <p class="h-card mt-5">{pr.title[lang]}</p>
            <p class="mt-3 text-[0.95rem]/relaxed text-ink-2">{pr.text[lang]}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <Experience lang={lang} full />
</Base>
